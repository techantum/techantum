# AI Lead CRM configuration.
# Provider API keys (Meta, Google, OpenAI, database) may be mapped from a local secrets file.
# Never commit real secrets.

CRM_APP_NAME=AI Lead CRM
CRM_NODE_ENV=development
CRM_WEB_PORT=4300
CRM_API_PORT=4301
CRM_WEB_URL=http://localhost:4300
CRM_API_URL=http://localhost:4300
CRM_DB_SCHEMA=crm
CRM_INTEGRATION_MODE=sandbox

# Dedicated AI CRM database (docker compose service ai-crm-db)
CRM_DATA_ISOLATED=true
CRM_DB_PASSWORD=change-me
CRM_DATABASE_URL=postgresql://ai_crm:change-me@127.0.0.1:5433/ai_crm
CRM_DIRECT_URL=postgresql://ai_crm:change-me@127.0.0.1:5433/ai_crm

CRM_AUTH_SECRET=replace-with-long-random-secret
CRM_ENCRYPTION_KEY=replace-with-32-byte-secret
SAAS_SESSION_SECRET=
LOCAL_SESSION_SECRET=

# Optional Redis (falls back to DB job table)
CRM_REDIS_URL=
REDIS_URL=

# Meta / WhatsApp
CRM_META_APP_ID=
CRM_META_APP_SECRET=
CRM_META_ACCESS_TOKEN=
CRM_WHATSAPP_PHONE_NUMBER_ID=
CRM_WHATSAPP_WABA_ID=
CRM_WHATSAPP_ACCESS_TOKEN=
CRM_WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Google Ads lead forms
CRM_GOOGLE_ADS_DEVELOPER_TOKEN=
CRM_GOOGLE_ADS_CLIENT_ID=
CRM_GOOGLE_ADS_CLIENT_SECRET=
CRM_GOOGLE_ADS_REFRESH_TOKEN=
CRM_GOOGLE_LEAD_WEBHOOK_KEY=

# Telephony / IVR
# Test without PSTN: CRM_TELEPHONY_PROVIDER=mock + any CRM_TELEPHONY_API_KEY
# Real IVR: set provider name + BASE_URL + API_KEY (points at your IVR REST dial API)
CRM_TELEPHONY_PROVIDER=mock
CRM_TELEPHONY_API_KEY=crm-mock-telephony-key
CRM_TELEPHONY_API_SECRET=
CRM_TELEPHONY_BASE_URL=mock://local
CRM_TELEPHONY_TRANSFER_QUEUE=
CRM_MAX_CONCURRENCY=5

# STT / TTS / LLM / OCR
CRM_LLM_PROVIDER=openai
CRM_LLM_API_KEY=
OPENAI_API_KEY=
CRM_STT_PROVIDER=
CRM_STT_API_KEY=
CRM_TTS_PROVIDER=
CRM_TTS_API_KEY=
CRM_OCR_PROVIDER=
CRM_OCR_API_KEY=

# Zoho CRM (India DC defaults)
CRM_ZOHO_CLIENT_ID=
CRM_ZOHO_CLIENT_SECRET=
CRM_ZOHO_REFRESH_TOKEN=
CRM_ZOHO_API_DOMAIN=https://www.zohoapis.in
CRM_ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

CRM_PUBLIC_WEBHOOK_BASE_URL=http://localhost:4300
CRM_WHATSAPP_TEMPLATE_NAME=
CRM_DATA_ISOLATED=false
CRM_OBJECT_STORAGE_URL=
CRM_KYC_PROVIDER=
CRM_KYC_AUTHORIZATION_REF=
CRM_TELEPHONY_CALLER_ID=
CRM_TELEPHONY_STREAM_URL=
CRM_LOAD_CONCURRENCY=20
CRM_LOAD_P95_MS=800
NEXT_PUBLIC_CRM_APP_NAME=AI Lead CRM
NEXT_PUBLIC_SITE_URL=http://localhost:4300
