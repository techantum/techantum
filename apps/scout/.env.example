# Postgres (required)
# DATABASE_URL = transaction pooler (port 6543, ?pgbouncer=true). Use this for the app.
# DIRECT_URL = direct db host (db.<project>.supabase.co:5432) for migrations only.
# Do not put the session pooler (*.pooler.supabase.com:5432) in DIRECT_URL — it allows ~15 clients total.
DATABASE_URL=
DIRECT_URL=
PG_POOL_MAX=3

# Supabase Auth + REST (required for signup/login and lead saves)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Encrypt YouTube API keys stored in the database
AI_SECRETS_ENCRYPTION_KEY=
SAAS_SESSION_SECRET=

# Public Data API — also configurable in YouTube Settings after login
YOUTUBE_API_KEY=

# Google Places (Lead Discovery)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DEFAULT_CITY=Hyderabad
GOOGLE_PLACES_DEFAULT_REGION=IN

# Optional AI (analysis). Keys can also live in ai_gateway_settings.
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Razorpay (INR checkout on Billing). Key ID is public; secret and webhook stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in (authorized redirect: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# WhatsApp OTP login (copied from the parent Techantum env when present)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LOGIN_OTP_TEMPLATE=
WHATSAPP_LOGIN_OTP_TEMPLATE_LANG=en
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Meta Graph (Facebook / Instagram page research). Prefer a system user or ads token with pages_read_engagement.
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_SYSTEM_USER_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ID=
META_AD_REACHED_COUNTRIES=IN,US,GB,AE,SG,AU,CA
# Optional. Defaults to {NEXT_PUBLIC_SITE_URL}/api/youtube/meta/facebook/callback
FACEBOOK_PAGE_OAUTH_REDIRECT=

# LinkedIn company pages (optional). Requires Organization lookup.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202411

# This app's public URL
NEXT_PUBLIC_REVEALEO_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Optional local PostgREST
# LOCAL_REST_URL=
# POSTGREST_JWT_SECRET=
