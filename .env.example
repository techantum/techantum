# Techantum environment variables (example)
# Copy to .env.local and fill in values. Never commit secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Meta WhatsApp Business Platform
META_WHATSAPP_ENABLED=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# WhatsApp Tech Provider console (super admin)
META_APP_ID=
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
META_BUSINESS_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_CALLBACK_URL=http://localhost:3005/api/webhooks/meta/whatsapp
META_CREDIT_LINE_ID=
FEATURE_META_CREDIT_SHARING=false
WA_PROVIDER_SEED_DEMO=false

# Meta Marketing API / Ads Analytics (same Meta App as App Review; ads_read)
# WhatsApp tokens do not count toward Marketing API Access Tier.
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
# Optional. Caps per-campaign insights calls in one sync (default 40, max 80).
# META_ADS_CAMPAIGN_INSIGHTS_LIMIT=40

# Legacy WhatsApp env names (still supported)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=techantum_client_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# OpenAI (WhatsApp AI assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VECTOR_STORE_ID=

# AI Gateway: encrypts API keys saved from Admin → AI Gateway.
# Generate with: openssl rand -hex 32
AI_SECRETS_ENCRYPTION_KEY=

# Website login (Supabase Auth → Providers: Google and Facebook)
# Redirect URL to add in Supabase: https://YOUR_DOMAIN/auth/callback
WHATSAPP_LOGIN_OTP_TEMPLATE=
WHATSAPP_LOGIN_OTP_TEMPLATE_LANG=en
LOGIN_OTP_PEPPER=

# Optional env fallbacks if a key is not saved in admin
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# WhatsApp AI feature flags
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_DEFAULT_MODE=AI
WHATSAPP_AI_AUTO_HANDOFF=true

# Email / contact
RESEND_API_KEY=
CONTACT_INBOX=

# Google Analytics 4 (admin Website Analytics dashboard)
# Property ID is numeric (Admin → Property settings). Measurement ID (G-…) goes in CMS SEO settings.
GA4_PROPERTY_ID=
# Prefer one of: full JSON, or email + private key
GA4_SERVICE_ACCOUNT_JSON=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Google Business Profile / Maps analytics (admin Maps / GBP Analytics dashboard)
# Reuses GA4 service account credentials unless GBP_* credentials are set.
# Add the service account as Manager on business.google.com → Users.
# Enable: Business Profile Performance API, Account Management API, Business Information API.
GBP_LOCATION_ID=
GBP_ACCOUNT_ID=
GBP_PROFILE_URL=
# Optional dedicated credentials (otherwise GA4_* is reused)
# GBP_SERVICE_ACCOUNT_JSON=
# GBP_CLIENT_EMAIL=
# GBP_PRIVATE_KEY=
# Owner Google login (preferred). Create a Web OAuth client and paste it in Admin → Maps / GBP Analytics.
# GBP_OAUTH_CLIENT_ID=
# GBP_OAUTH_CLIENT_SECRET=

# Google Places (Lead Discovery)
GOOGLE_PLACES_API_KEY=

# Google Calendar (WhatsApp appointment booking)
# Create a Google Cloud service account, enable Calendar API, share the booking calendar with the service account.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
# Optional. Use if Workspace greys out "Make changes to events" for the service account.
# Requires Google Workspace domain-wide delegation for this service account.
GOOGLE_CALENDAR_IMPERSONATE=
